# Copia este archivo a ".env.local" y rellena tus claves reales.
# Las claves "sk_test_..." / "pk_test_..." son de PRUEBA. Para cobros reales
# usa las que empiezan por "sk_live_..." / "pk_live_...".

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_TU_CLAVE_AQUI
STRIPE_SECRET_KEY=sk_test_TU_CLAVE_AQUI

# URL pública donde queda publicada la tienda (sin barra final)
NEXT_PUBLIC_SITE_URL=https://lakshmi-store.vercel.app

# --- Aviso por email de cada pedido ---
# 1) Clave "signing secret" del webhook de Stripe (empieza por whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_TU_CLAVE_AQUI
# 2) Clave de API de Resend (servicio gratuito para enviar emails, hasta
#    3.000 al mes gratis): resend.com
RESEND_API_KEY=re_TU_CLAVE_AQUI
# 3) El email donde quieres recibir el aviso de cada pedido
STORE_OWNER_EMAIL[email protected]
